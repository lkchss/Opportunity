# Keep the Vercel deployment lean — only what the Flask function needs at
# runtime (law/*.py, law/web/**, law/data/law_schools.json) ships. Everything
# below is dev/build-time only and never imported or read by law.server.
mvp/
tests/
eval/
run_*.py
algorithm_test_results*.txt
law/data/raw/
law/data/build_*.py
law/data/*.xlsx
render.yaml
# Anchored to root: exclude ONLY the heavy dev/MVP requirements.txt.
# An unanchored `requirements.txt` also matches api/requirements.txt, which
# starves the Python builder of flask and stops the api/index function from
# being built at all (every route then 404s with NOT_FOUND).
/requirements.txt
**/__pycache__/
.pytest_cache/
.git/
